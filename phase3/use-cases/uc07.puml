@startuml
skinparam backgroundColor white-white
title UC07 — Удаление расхода
skinparam shadowing false
start
:Участник выбирает удаление расхода;
if (Есть доступ к группе?) then (нет)
  :Система отказывает в доступе;
  stop
endif
if (Расход уже удалён?) then (да)
  :Система сообщает о выполненном удалении;
  :Повторная запись в истории не создаётся;
  stop
endif
if (Участник — автор или организатор?) then (нет)
  :Система запрещает удаление;
  stop
endif
:Система запрашивает подтверждение;
if (Удаление подтверждено?) then (нет)
  :Расход остаётся прежним;
  stop
endif
if (Удаление успешно?) then (да)
  :Система помечает расход удалённым;
  :Система исключает его из расчёта балансов;
  :Система сохраняет событие в истории;
  :Система показывает новые балансы;
else (нет)
  :Система сообщает об ошибке;
  :Расход продолжает учитываться;
endif
stop
@enduml
