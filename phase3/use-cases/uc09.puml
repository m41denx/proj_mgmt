@startuml
skinparam backgroundColor white-white
title UC09 — Просмотр баланса
skinparam shadowing false
start
:Участник открывает баланс группы;
if (Есть доступ к группе?) then (нет)
  :Система отказывает в доступе;
  stop
endif
if (Данные удалось прочитать?) then (нет)
  :Система сообщает об ошибке загрузки;
  :Баланс не подменяется нулями;
  stop
endif
if (В группе есть операции?) then (да)
  :Система читает расходы, доли
и отметки погашения;
  :Система рассчитывает баланс
каждого участника;
else (нет)
  :Все балансы принимаются равными нулю;
endif
:Система показывает участников,
суммы к получению и к погашению;
:Данные группы не изменяются;
stop
@enduml
