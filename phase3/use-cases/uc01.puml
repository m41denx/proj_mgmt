@startuml
skinparam backgroundColor white-white
title UC01 — Регистрация
skinparam shadowing false
start
:Посетитель вводит имя,
email и пароль;
while (Формат данных неверен?) is (да)
  :Система показывает ошибки полей;
  if (Посетитель продолжает?) then (да)
    :Посетитель исправляет данные;
  else (нет)
    :Учётная запись не создана;
    stop
  endif
endwhile (нет)
if (Email уже занят?) then (да)
  :Система предлагает перейти ко входу;
  :Новая запись не создана;
  stop
endif
if (Сохранение успешно?) then (да)
  :Система создаёт учётную запись;
  :Система показывает подтверждение;
else (нет)
  :Система сообщает об ошибке;
  :Учётная запись не создана;
endif
stop
@enduml
