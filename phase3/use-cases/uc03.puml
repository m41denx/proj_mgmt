@startuml
skinparam backgroundColor white-white
title UC03 — Создание группы
skinparam shadowing false
start
if (Пользователь вошёл в учётную запись?) then (нет)
  :Система предлагает выполнить вход;
  :Группа не создана;
  stop
endif
:Пользователь вводит название группы
и имена участников;
if (Название и имена заполнены?) then (да)
  if (Сохранение успешно?) then (да)
    :Система создаёт группу в рублях;
    :Система назначает создателя организатором;
    :Система создаёт профили участников
без требования регистрации;
    :Система открывает группу с нулевыми балансами;
  else (нет)
    :Система сообщает об ошибке;
    :Группа и её участники не сохранены;
  endif
else (нет)
  :Система показывает ошибки полей;
  :Пользователь может исправить данные;
endif
stop
@enduml
