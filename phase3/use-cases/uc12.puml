@startuml
skinparam backgroundColor white-white
title UC12 — История операций
skinparam shadowing false
start
:Участник открывает историю группы;
if (Есть доступ к группе?) then (нет)
  :Система отказывает в доступе;
  stop
endif
if (История прочитана успешно?) then (нет)
  :Система сообщает об ошибке загрузки;
  stop
endif
if (Операции есть?) then (да)
  :Система показывает добавления,
изменения и удаления расходов,
а также отметки погашения;
  if (Участник выбрал запись?) then (да)
    :Система показывает автора,
вид операции, сумму и детали изменения;
  endif
  if (Нужны следующие записи?) then (да)
    :Система загружает следующую часть истории;
  endif
else (нет)
  :Система показывает пустую историю;
endif
:История не изменяется;
stop
@enduml
