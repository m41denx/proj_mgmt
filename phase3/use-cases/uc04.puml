@startuml
skinparam backgroundColor white-white
title UC04 — Приглашение и присоединение
skinparam shadowing false
start
:Организатор выбирает профиль участника;
if (Есть право приглашать?) then (нет)
  :Система отказывает в доступе;
  stop
endif
:Система создаёт личную ссылку-приглашение;
:Организатор передаёт ссылку приглашённому;
:Приглашённый открывает ссылку;
if (Это повторный вход того же участника?) then (да)
  :Система открывает группу
без создания нового участника;
  stop
endif
if (Приглашение действительно
и ещё не использовано?) then (нет)
  :Система сообщает о недействительной ссылке;
  :Доступ к группе не предоставлен;
  stop
endif
if (Присоединиться с учётной записью?) then (да)
  :Приглашённый выполняет вход;
  if (Вход успешен?) then (нет)
    :Присоединение не выполнено;
    stop
  endif
else (нет)
  :Приглашённый выбирает гостевой вход;
endif
if (Присоединение успешно?) then (да)
  :Система связывает сеанс с выбранным профилем;
  :Система помечает приглашение использованным;
  :Система открывает группу;
else (нет)
  :Система сообщает об ошибке;
  :Приглашение остаётся доступным для повтора;
endif
stop
@enduml
