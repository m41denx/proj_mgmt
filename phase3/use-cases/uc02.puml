@startuml
skinparam backgroundColor white-white
title UC02 — Вход
skinparam shadowing false
start
if (Сеанс уже действителен?) then (да)
  :Система открывает список групп;
  stop
endif
:Посетитель вводит email и пароль;
if (Сервис доступен?) then (да)
  if (Данные входа верны?) then (да)
    :Система создаёт сеанс;
    :Система открывает список групп;
  else (нет)
    :Система сообщает об ошибке входа;
    :Сеанс не создан;
  endif
else (нет)
  :Система предлагает повторить вход;
  :Сеанс не создан;
endif
stop
@enduml
